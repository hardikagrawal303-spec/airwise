# AirWise Environment Configuration (placeholder values only — never commit real secrets)

# Optional: Gemini API key from Google AI Studio.
# App starts and provides full rule-based guidance even if left empty.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model ID (verify active model names in Google AI Studio)
GEMINI_MODEL=gemini-4-hydrogen

# Server port (defaults to 3000)
PORT=3000

# Runtime environment: development | production | test
NODE_ENV=development

# Rate limiting window in milliseconds (default 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum general API requests per IP per window
RATE_LIMIT_MAX=100

# Optional: maximum /api/geocode requests per IP per window (defaults to half of RATE_LIMIT_MAX)
GEOCODE_RATE_LIMIT_MAX=50

# Air quality cache TTL in seconds (default 10 minutes)
AQI_CACHE_TTL_SECONDS=600

# Express trust proxy setting (false, non-negative integer hop count e.g. 1, or CIDR range(s); "true" is rejected).
# Defaults to 1 when running on Cloud Run or AI Studio preview, and false locally.
TRUST_PROXY=

# Comma-separated list of additional allowed Origin headers
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
