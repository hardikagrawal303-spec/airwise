{
  "name": "airwise",
  "private": true,
  "version": "1.0.0",
  "description": "GenAI-powered Urban Air Quality Assistant for North Indian families navigating winter smog",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "build": "node --check src/server.js && node --check src/app.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"public/js/**/*.js\" \"tests/**/*.js\""
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "jsdom": "25.0.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "collectCoverageFrom": [
      "src/engine/**/*.js",
      "src/services/**/*.js",
      "src/utils/**/*.js"
    ]
  }
}
